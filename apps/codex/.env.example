# DeepSeek API Configuration
# Get your API key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI Configuration (for embeddings and fallback)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
# For development, you can use SQLite (file-based)
DATABASE_URL=file:../mastra.db

# For production, consider PostgreSQL
# DATABASE_URL=postgresql://username:password@localhost:5432/mastra_db

# Logging Configuration
LOG_LEVEL=info
LOG_NAME=DeepSeek-Mastra

# Server Configuration
SERVER_PORT=4111
SERVER_HOST=localhost

# Memory Configuration
MEMORY_LAST_MESSAGES=15
MEMORY_SEMANTIC_RECALL_TOP_K=5
MEMORY_SEMANTIC_RECALL_MESSAGE_RANGE=3

# Vector Database Configuration (for RAG)
VECTOR_DB_URL=file:../mastra.db
EMBEDDING_MODEL=text-embedding-3-small

# MCP Server Configuration
MCP_SERVER_PORT=3001
MCP_SERVER_HOST=localhost

# Development Configuration
NODE_ENV=development
DEBUG=false

# Optional: Additional AI Provider Keys
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GOOGLE_API_KEY=your_google_key_here
# COHERE_API_KEY=your_cohere_key_here

# Optional: External Services
# GITHUB_TOKEN=your_github_token_here
# SLACK_BOT_TOKEN=your_slack_token_here
